# docker 이미지 파일을 만드는 형식 => Dockerfile 파일명
# 도커 이미지 는 레이어 단위로 구성
# 가장 중요하고 가장 먼저 선언 할것은 어떤 이미지를 가지고 시작할것인지 결정
FROM eclipse-temurin:21-jre-alpine

WORKDIR /app

# 이미지 만들때 파일을 복사해라
# COPY 로컬컴퓨터소스폴더 이미지내의대상폴더
COPY ./hotel /app

# application.yaml 에 하드코딩된 실제 포트
EXPOSE 8989

# DB 접속정보/포트는 application.yaml에 하드코딩 되어 있으므로
# docker-compose 의 environment 값(SPRING_DATASOURCE_URL 등)으로 덮어씁니다.
ENTRYPOINT ["java", "-server", "-jar", "hotel-0.0.1-SNAPSHOT.jar"]

# 이미지 빌드
# docker build -f Dockerfile.dev -t 이미지명:버전명 .
