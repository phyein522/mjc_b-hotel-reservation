# Gmail SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=your-google-app-password

# Optional. When omitted, MAIL_USERNAME is used as the sender address.
# MAIL_FROM=your-account@gmail.com

# Generate a different random value for each environment.
EMAIL_VERIFICATION_SECRET=replace-with-a-long-random-secret

# Google Cloud OAuth 2.0 Web application client ID
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
